<Window x:Class="AuraIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura Island" Width="360" Height="76"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Loaded="Window_Loaded">
    <Border x:Name="IslandBorder" Background="#F014171D" CornerRadius="30"
            BorderBrush="#303A414D" BorderThickness="1" Padding="18,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="CompactPanel" MouseLeftButtonDown="Island_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="#71E3B1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" Text="19:09" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DateText" Text="Wednesday, 11 November" Foreground="#AAB2C0" FontSize="10"/>
                </StackPanel>
                <TextBlock x:Name="ExpandGlyph" Grid.Column="2" Text="⌄" Foreground="#B7C0CC" FontSize="18"
                           VerticalAlignment="Center" Margin="12,0,2,0"/>
            </Grid>
            <StackPanel x:Name="ExpandedPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,18,0,2">
                <TextBlock Text="SYSTEM STATUS" Foreground="#8D9AAA" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Processor" Foreground="#DCE3EC" FontSize="12"/>
                    <TextBlock x:Name="CpuText" Grid.Column="1" Text="0%" Foreground="White" FontSize="12"/>
                </Grid>
                <ProgressBar x:Name="CpuBar" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Memory" Foreground="#DCE3EC" FontSize="12"/>
                    <TextBlock x:Name="RamText" Grid.Column="1" Text="0%" Foreground="White" FontSize="12"/>
                </Grid>
                <ProgressBar x:Name="RamBar" Height="5" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,14"/>
                <Button x:Name="ThemeButton" Content="Switch theme" Click="ThemeButton_Click" HorizontalAlignment="Stretch"
                        Padding="10,7" Background="#29313D" Foreground="White" BorderThickness="0"/>
                <TextBlock Text="Aura Island • prototype" Foreground="#788493" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
